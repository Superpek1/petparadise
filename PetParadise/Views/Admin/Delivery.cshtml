@model IEnumerable<PetParadise.Models.Order>

<div class="container mt-4">
    <h3 class="fw-bold mb-4">ระบบจัดการการจัดส่งสินค้า</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order ID</th>
                                <th>ข้อมูลผู้รับและที่อยู่จัดส่ง</th>
                                <th>รายการสินค้า</th>
                                <th>สถานะจัดส่ง</th>
                                <th>อัปเดตสถานะจัดส่ง</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ord in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@ord.OrderId<br /><small class="text-muted">@ord.OrderDate?.ToString("dd/MM/yy HH:mm")</small></td>
                                    <td>
                                        <strong>ผู้รับ: @ord.Address.RecipientName</strong> (โทร: @ord.Address.Phone)<br />
                                        <span class="text-muted small">@ord.Address.AddressDetail @ord.Address.District @ord.Address.Province @ord.Address.PostalCode</span>
                                    </td>
                                    <td>
                                        <ul class="mb-0 ps-3 small">
                                            @foreach (var item in ord.Orderitems)
                                            {
                                                <li>@item.Product.ProductName (x@(item.Quantity))</li>
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        <span class="badge @(ord.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@ord.Status</span>
                                    </td>
                                    <td>
                                        <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="orderId" value="@ord.OrderId" />
                                            <input type="hidden" name="returnUrl" value="/Admin/Delivery" />
                                            @if (ord.Status == "Preparing")
                                            {
                                                <button type="submit" name="newStatus" value="Shipped" class="btn btn-primary btn-sm fw-bold">รับพัสดุ / กำลังจัดส่ง (Shipped)</button>
                                            }
                                            else if (ord.Status == "Shipped")
                                            {
                                                <button type="submit" name="newStatus" value="Completed" class="btn btn-success btn-sm fw-bold">ยืนยันส่งมอบสำเร็จ (Completed)</button>
                                            }
                                            else
                                            {
                                                <span class="text-success small fw-bold">✓ จัดส่งเรียบร้อยแล้ว</span>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">ยังไม่มีรายการพัสดุที่พร้อมจัดส่งในขณะนี้</p>
            }
        </div>
    </div>
</div>