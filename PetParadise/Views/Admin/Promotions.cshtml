@model IEnumerable<PetParadise.Models.Promotion>
@{
    var systemNotes = PetParadise.Models.PromotionHelper.LoadSystemNotes();
    var currentRole = Context.Session.GetString("Role");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">🎁 จัดการโปรโมชั่นและโค้ดส่วนลด</h3>
        @if (currentRole == "Admin" || currentRole == "Owner")
        {
            <a asp-action="Dashboard" class="btn btn-outline-secondary">กลับหน้า Dashboard</a>
        }
        else if (currentRole == "Marketing")
        {
            <a asp-action="Reports" class="btn btn-outline-primary">📊 ดูรายงานสินค้าขายดี & ยอดขาย</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- ฟอร์มเพิ่มโปรโมชั่นใหม่ -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0 text-white">+ สร้างโปรโมชั่นใหม่</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreatePromotion" method="post" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold small">ชื่อโปรโมชั่น</label>
                    <input type="text" name="PromotionName" class="form-control form-control-sm" placeholder="เช่น ส่วนลดสมาชิกใหม่ 10%" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small">โค้ดส่วนลด (Code)</label>
                    <input type="text" name="promoCode" class="form-control form-control-sm text-uppercase" placeholder="เช่น NEW10" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">ประเภทโปรโมชั่น</label>
                    <select name="PromotionType" id="promoType" class="form-select form-select-sm" onchange="toggleDiscountFields()">
                        <option value="FirstOrder">1. ส่วนลดสมาชิกใหม่ (FirstOrder)</option>
                        <option value="Fixed">2. ซื้อครบลดทันทีเป็นจำนวนเงิน (Fixed)</option>
                        <option value="BulkItem">3. ซื้อจำนวนมาก 3 ชิ้นขึ้นไปลดเพิ่ม (BulkItem)</option>
                        <option value="FreeShipping">4. ส่งฟรีเมื่อซื้อครบขั้นต่ำ (FreeShipping)</option>
                        <option value="BirthdayPet">5. เดือนเกิดสัตว์เลี้ยง (BirthdayPet)</option>
                        <option value="Percent">ลดเปอร์เซ็นต์ทั่วไป (Percent)</option>
                    </select>
                </div>
                <div class="col-md-2" id="percentField">
                    <label class="form-label fw-bold small">ส่วนลด (%)</label>
                    <input type="number" step="0.01" min="0" max="100" name="DiscountPercent" class="form-control form-control-sm" placeholder="เช่น 10" />
                </div>
                <div class="col-md-2" id="amountField" style="display:none;">
                    <label class="form-label fw-bold small">ส่วนลด (บาท)</label>
                    <input type="number" step="0.01" min="0" name="DiscountAmount" class="form-control form-control-sm" placeholder="เช่น 150" />
                </div>
                <div class="col-md-2" id="maxDiscountField">
                    <label class="form-label fw-bold small">ลดสูงสุด (บาท)</label>
                    <input type="number" step="0.01" min="0" name="MaxDiscount" class="form-control form-control-sm" placeholder="เว้นว่างได้" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small">ยอดซื้อขั้นต่ำ (บาท)</label>
                    <input type="number" step="0.01" min="0" name="MinPurchase" class="form-control form-control-sm" value="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">วันที่เริ่มต้น</label>
                    <input type="date" name="StartDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">วันที่สิ้นสุด</label>
                    <input type="date" name="EndDate" class="form-control form-control-sm" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">บันทึกโปรโมชั่น</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ตารางรายการโปรโมชั่นทั้งหมด พร้อมแก้ไขเงื่อนไขได้ -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID / โค้ด</th>
                            <th>ชื่อโปรโมชั่น & ประเภท</th>
                            <th>รายละเอียดส่วนลด</th>
                            <th>ขั้นต่ำ / ลดสูงสุด</th>
                            <th>ระยะเวลา</th>
                            <th>สถานะ</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            string code = PetParadise.Models.PromotionHelper.GetPromoCode(p, systemNotes);
                            <tr>
                                <td>
                                    <div class="fw-bold">#@p.PromotionId</div>
                                    <span class="badge bg-warning text-dark">โค้ด: @code</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@p.PromotionName</div>
                                    <small class="text-muted">ประเภท: @p.PromotionType</small>
                                </td>
                                <td>
                                    @if (p.PromotionType == "FreeShipping")
                                    {
                                        <span class="badge bg-success">ส่งฟรี</span>
                                    }
                                    else if (p.PromotionType == "Fixed")
                                    {
                                        <span class="badge bg-info text-dark">ลด @p.DiscountAmount?.ToString("N2") ฿</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">ลด @p.DiscountPercent?.ToString("N0")%</span>
                                    }
                                </td>
                                <td class="small">
                                    ขั้นต่ำ: @((p.MinPurchase ?? 0).ToString("N2")) ฿<br />
                                    @if (p.MaxDiscount != null && p.MaxDiscount > 0)
                                    {
                                        <span class="text-muted">สูงสุด: @p.MaxDiscount?.ToString("N2") ฿</span>
                                    }
                                </td>
                                <td class="small">@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (p.Status == true)
                                    {
                                        <span class="badge bg-success">เปิดใช้งาน</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ปิดใช้งาน</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#editPromo_@p.PromotionId">
                                            แก้ไข
                                        </button>
                                        <form asp-action="TogglePromotionStatus" method="post">
                                            <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                                @(p.Status == true ? "ปิด" : "เปิด")
                                            </button>
                                        </form>
                                        <form asp-action="DeletePromotion" method="post" onsubmit="return confirm('ยืนยันการลบโปรโมชั่น @p.PromotionName ?');">
                                            <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <tr class="collapse bg-light" id="editPromo_@p.PromotionId">
                                <td colspan="7" class="p-3">
                                    <form asp-action="EditPromotion" method="post" class="row g-2 align-items-end">
                                        <input type="hidden" name="PromotionId" value="@p.PromotionId" />
                                        <div class="col-md-2">
                                            <label class="form-label small fw-bold mb-1">ชื่อโปรโมชั่น</label>
                                            <input type="text" name="PromotionName" class="form-control form-control-sm" value="@p.PromotionName" required />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">โค้ด</label>
                                            <input type="text" name="promoCode" class="form-control form-control-sm text-uppercase" value="@code" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-bold mb-1">ประเภท</label>
                                            <select name="PromotionType" class="form-select form-select-sm">
                                                <option value="FirstOrder" selected="@(p.PromotionType == "FirstOrder")">FirstOrder</option>
                                                <option value="Fixed" selected="@(p.PromotionType == "Fixed")">Fixed</option>
                                                <option value="BulkItem" selected="@(p.PromotionType == "BulkItem")">BulkItem</option>
                                                <option value="FreeShipping" selected="@(p.PromotionType == "FreeShipping")">FreeShipping</option>
                                                <option value="BirthdayPet" selected="@(p.PromotionType == "BirthdayPet")">BirthdayPet</option>
                                                <option value="Percent" selected="@(p.PromotionType == "Percent")">Percent</option>
                                            </select>
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">ลด (%)</label>
                                            <input type="number" step="0.01" name="DiscountPercent" class="form-control form-control-sm" value="@p.DiscountPercent" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">ลด (฿)</label>
                                            <input type="number" step="0.01" name="DiscountAmount" class="form-control form-control-sm" value="@p.DiscountAmount" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">ขั้นต่ำ</label>
                                            <input type="number" step="0.01" name="MinPurchase" class="form-control form-control-sm" value="@p.MinPurchase" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">สูงสุด</label>
                                            <input type="number" step="0.01" name="MaxDiscount" class="form-control form-control-sm" value="@p.MaxDiscount" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">เริ่ม</label>
                                            <input type="date" name="StartDate" class="form-control form-control-sm" value="@p.StartDate.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-bold mb-1">สิ้นสุด</label>
                                            <input type="date" name="EndDate" class="form-control form-control-sm" value="@p.EndDate.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div class="col-md-1">
                                            <button type="submit" class="btn btn-primary btn-sm w-100">บันทึก</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleDiscountFields() {
        var type = document.getElementById("promoType").value;
        var isFixed = (type === "Fixed");
        var isFreeShip = (type === "FreeShipping");

        document.getElementById("percentField").style.display = (!isFixed && !isFreeShip) ? "block" : "none";
        document.getElementById("maxDiscountField").style.display = (!isFixed && !isFreeShip) ? "block" : "none";
        document.getElementById("amountField").style.display = isFixed ? "block" : "none";
    }
</script>
