@model IEnumerable<PetParadise.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User List (รายการผู้ใช้งาน)</h2>
        <a asp-action="AddUser" class="btn btn-primary">+ Add User</a>
    </div>

    <table class="table table-bordered table-striped text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>User ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Phone</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Phone</td>
                    <td><span class="badge bg-success">@user.Role</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>