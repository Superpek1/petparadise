@model PetParadise.Models.User
@{
    var petVerifications = ViewBag.PetVerifications as Dictionary<int, PetParadise.Models.PetVerificationNote>
                           ?? new Dictionary<int, PetParadise.Models.PetVerificationNote>();
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <!-- ฝั่งซ้าย: ข้อมูลส่วนตัว & ข้อมูลสัตว์เลี้ยง -->
        <div class="col-md-4">
            <!-- กล่องข้อมูลส่วนตัว + ฟอร์มแก้ไขข้อมูลส่วนตัว -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 text-white">👤 ข้อมูลส่วนตัว & แก้ไขโปรไฟล์</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditProfile" method="post">
                        <input type="hidden" name="userId" value="@Model.UserId" />
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">ชื่อผู้ใช้ (Username)</label>
                            <input type="text" class="form-control form-control-sm bg-light" value="@Model.Username" readonly />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">ชื่อจริง</label>
                                <input type="text" name="firstName" class="form-control form-control-sm" value="@Model.FirstName" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">นามสกุล</label>
                                <input type="text" name="lastName" class="form-control form-control-sm" value="@Model.LastName" required />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">อีเมล</label>
                            <input type="email" name="email" class="form-control form-control-sm" value="@Model.Email" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">เบอร์โทรศัพท์</label>
                            <input type="text" name="phone" class="form-control form-control-sm" value="@Model.Phone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">รหัสผ่านใหม่ (เว้นว่างหากไม่เปลี่ยน)</label>
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="••••••" />
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm fw-bold">บันทึกข้อมูลส่วนตัว</button>
                            <a asp-action="Logout" class="btn btn-outline-danger btn-sm">ออกจากระบบ</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- กล่องลงทะเบียนข้อมูลสัตว์เลี้ยง (สำหรับโปรโมชั่น Birthday Pet ลด 20%) -->
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0 fw-bold">🐾 สัตว์เลี้ยงของฉัน (Birthday Pet)</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        ลงทะเบียนวันเกิดสัตว์เลี้ยงเพื่อรับส่วนลด <strong>20% (สูงสุด 200 บาท)</strong> ในเดือนเกิดของสัตว์เลี้ยง!
                    </p>

                    @if (Model.Pets != null && Model.Pets.Any())
                    {
                        foreach (var pet in Model.Pets)
                        {
                            var verify = petVerifications.ContainsKey(pet.PetId) ? petVerifications[pet.PetId] : null;
                            string vStatus = verify?.Status ?? "Pending";
                            bool isBirthMonth = pet.BirthDate != null && pet.BirthDate.Value.Month == DateTime.Now.Month;
                            <div class="border rounded p-2 mb-2 bg-light">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="d-flex gap-2 align-items-center">
                                        @if (!string.IsNullOrEmpty(verify?.ImageUrl))
                                        {
                                            <a href="@verify.ImageUrl" target="_blank" title="คลิกเพื่อดูรูปขนาดใหญ่">
                                                <img src="@verify.ImageUrl" alt="@pet.PetName" class="rounded border" style="width: 56px; height: 56px; object-fit: cover;" />
                                            </a>
                                        }
                                        <div>
                                            <div>
                                                <strong>@pet.PetName</strong> <span class="badge bg-secondary">@pet.PetType</span>
                                            </div>
                                            <div class="small text-muted">
                                                วันเกิด: @(pet.BirthDate?.ToString("dd/MM/yyyy") ?? "ไม่ระบุ")
                                            </div>
                                            <div class="mt-1 d-flex flex-wrap gap-1">
                                                @if (vStatus == "Approved")
                                                {
                                                    <span class="badge bg-success">✅ เจ้าหน้าที่ยืนยันแล้ว</span>
                                                    @if (isBirthMonth)
                                                    {
                                                        <span class="badge bg-warning text-dark">🎂 เดือนเกิด! ใช้สิทธิ์ลด 20% ได้ทันที</span>
                                                    }
                                                }
                                                else if (vStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger">❌ ไม่ผ่านการอนุมัติ @(string.IsNullOrEmpty(verify?.Remark) ? "" : $"({verify.Remark})")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">⏳ รอเจ้าหน้าที่ (Staff) ตรวจสอบรูปภาพ</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <form asp-action="DeletePet" method="post">
                                        <input type="hidden" name="petId" value="@pet.PetId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">ยังไม่ได้ลงทะเบียนสัตว์เลี้ยง</p>
                    }

                    <hr />
                    <h6 class="fw-bold small mb-2">+ ลงทะเบียนสัตว์เลี้ยงพร้อมแนบรูปยืนยัน</h6>
                    <form asp-action="AddPet" method="post" enctype="multipart/form-data" class="row g-2">
                        <input type="hidden" name="userId" value="@Model.UserId" />
                        <div class="col-7">
                            <input type="text" name="petName" class="form-control form-control-sm" placeholder="ชื่อสัตว์เลี้ยง" required />
                        </div>
                        <div class="col-5">
                            <select name="petType" class="form-select form-select-sm">
                                <option value="สุนัข">สุนัข</option>
                                <option value="แมว">แมว</option>
                                <option value="อื่นๆ">อื่นๆ</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted mb-1">วันเดือนปีเกิดสัตว์เลี้ยง</label>
                            <input type="date" name="birthDate" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted mb-1">แนบรูปถ่ายสัตว์เลี้ยงจริง (สำหรับให้ Staff ตรวจสอบ) *</label>
                            <input type="file" name="petImage" class="form-control form-control-sm" accept="image/*" required />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold">ส่งข้อมูลให้เจ้าหน้าที่ตรวจสอบ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ฝั่งขวา: ที่อยู่จัดส่ง & ประวัติคำสั่งซื้อ -->
        <div class="col-md-8">
            <!-- กล่องที่อยู่จัดส่ง -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-white">📍 ที่อยู่จัดส่งของฉัน</h5>
                </div>
                <div class="card-body">
                    @if (Model.Addresses.Any())
                    {
                        foreach (var addr in Model.Addresses)
                        {
                            <div class="border rounded p-3 mb-2 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@addr.RecipientName</strong> (โทร: @addr.Phone)
                                        @if (addr.IsDefault == true)
                                        {
                                            <span class="badge bg-success ms-2">ค่าเริ่มต้น</span>
                                        }
                                        <p class="mb-0 text-muted small mt-1">
                                            @addr.AddressDetail เขต/อำเภอ @addr.District จังหวัด @addr.Province @addr.PostalCode
                                        </p>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#editAddr_@addr.AddressId">
                                            แก้ไข
                                        </button>
                                        <form asp-action="DeleteAddress" method="post">
                                            <input type="hidden" name="addressId" value="@addr.AddressId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                                        </form>
                                    </div>
                                </div>

                                <div class="collapse mt-3 pt-3 border-top" id="editAddr_@addr.AddressId">
                                    <form asp-action="EditAddress" method="post" class="row g-2">
                                        <input type="hidden" name="AddressId" value="@addr.AddressId" />
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold mb-1">ชื่อผู้รับ</label>
                                            <input type="text" name="RecipientName" class="form-control form-control-sm" value="@addr.RecipientName" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold mb-1">เบอร์โทรศัพท์</label>
                                            <input type="text" name="Phone" class="form-control form-control-sm" value="@addr.Phone" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small fw-bold mb-1">บ้านเลขที่ ซอย ถนน แขวง/ตำบล</label>
                                            <input type="text" name="AddressDetail" class="form-control form-control-sm" value="@addr.AddressDetail" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold mb-1">เขต/อำเภอ</label>
                                            <input type="text" name="District" class="form-control form-control-sm" value="@addr.District" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold mb-1">จังหวัด</label>
                                            <input type="text" name="Province" class="form-control form-control-sm" value="@addr.Province" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold mb-1">รหัสไปรษณีย์</label>
                                            <input type="text" name="PostalCode" class="form-control form-control-sm" value="@addr.PostalCode" required />
                                        </div>
                                        <div class="col-12 text-end">
                                            <button type="submit" class="btn btn-primary btn-sm">บันทึกการแก้ไขที่อยู่</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">ยังไม่มีข้อมูลที่อยู่จัดส่ง</p>
                    }

                    <hr />
                    <!-- ฟอร์มเพิ่มที่อยู่ใหม่ -->
                    <h6 class="fw-bold mb-3">+ เพิ่มที่อยู่จัดส่งใหม่</h6>
                    <form asp-action="AddAddress" method="post" class="row g-2">
                        <input type="hidden" name="UserId" value="@Model.UserId" />
                        <div class="col-md-6">
                            <input type="text" name="RecipientName" class="form-control form-control-sm" placeholder="ชื่อผู้รับ" required />
                        </div>
                        <div class="col-md-6">
                            <input type="text" name="Phone" class="form-control form-control-sm" placeholder="เบอร์โทรศัพท์" required />
                        </div>
                        <div class="col-12">
                            <input type="text" name="AddressDetail" class="form-control form-control-sm" placeholder="บ้านเลขที่ ซอย ถนน แขวง/ตำบล" required />
                        </div>
                        <div class="col-md-4">
                            <input type="text" name="District" class="form-control form-control-sm" placeholder="เขต/อำเภอ" required />
                        </div>
                        <div class="col-md-4">
                            <input type="text" name="Province" class="form-control form-control-sm" placeholder="จังหวัด" required />
                        </div>
                        <div class="col-md-4">
                            <input type="text" name="PostalCode" class="form-control form-control-sm" placeholder="รหัสไปรษณีย์" required />
                        </div>
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-primary btn-sm">บันทึกที่อยู่</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- กล่องประวัติคำสั่งซื้อ -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0 text-white">ประวัติคำสั่งซื้อ</h5>
                </div>
                <div class="card-body">
                    @if (Model.Orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>เลขที่</th>
                                        <th>วันที่สั่งซื้อ</th>
                                        <th>ยอดสุทธิ</th>
                                        <th>สถานะ</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ord in Model.Orders.OrderByDescending(o => o.OrderDate))
                                    {
                                        <tr>
                                            <td>#@ord.OrderId</td>
                                            <td>@ord.OrderDate?.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold text-danger">@ord.TotalAmount.ToString("N2") ฿</td>
                                            <td><span class="badge bg-info text-dark">@ord.Status</span></td>
                                            <td>
                                                <a asp-controller="Order" asp-action="Tracking" asp-route-orderId="@ord.OrderId" class="btn btn-outline-primary btn-sm">ติดตาม</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">ยังไม่มีประวัติการสั่งซื้อ</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
