@model PetParadise.ViewModels.AddUserViewModel

@{
    ViewData["Title"] = "เพิ่มผู้ใช้ใหม่";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">เพิ่มผู้ใช้ใหม่ (Add User)</h2>
        <form asp-controller="Account" asp-action="AddUser" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-2">
                <label class="form-label">Username</label>
                <input asp-for="Username" class="form-control auth-input" placeholder="กรอกชื่อผู้ใช้" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control auth-input" placeholder="กรอกชื่อจริง" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control auth-input" placeholder="กรอกนามสกุล" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="form-label">อีเมล</label>
                <input asp-for="Email" class="form-control auth-input" placeholder="กรอกอีเมล" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="form-label">พาส</label>
                <input asp-for="Password" class="form-control auth-input" type="password" placeholder="กรอกรหัสผ่าน" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="form-label">เบอร์</label>
                <input asp-for="Phone" class="form-control auth-input" placeholder="กรอกเบอร์โทรศัพท์" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">สิทธิ์การใช้งาน (Role)</label>
                <select asp-for="Role" class="form-select auth-input">
                    <option value="Customer">Customer</option>
                    <option value="Staff">Staff</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn auth-btn w-100">บันทึกข้อมูล</button>
        </form>
    </div>
</div>