@using Microsoft.AspNetCore.Http
@inject PetParadise.Models.Csi402dbContext DbContext
@{
    var currentRole = Context.Session.GetString("Role");
    var currentUsername = Context.Session.GetString("Username");
    var currentUserId = Context.Session.GetInt32("UserId");
    int cartItemCount = 0;
    try
    {
        if (currentUserId != null)
        {
            cartItemCount = DbContext.Cartitems
                .Where(ci => ci.Cart.UserId == currentUserId.Value)
                .Sum(ci => (int?)ci.Quantity) ?? 0;
        }
    }
    catch
    {
        cartItemCount = 0;
    }
}
<!DOCTYPE html>
<html lang="th" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetParadise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=3" />
    <link rel="stylesheet" href="~/PetParadise.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-modern sticky-top mb-4">
            <div class="container-xxl px-3">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2 text-nowrap me-2" style="color: #0d9488;" asp-controller="Home" asp-action="Index">
                    <span>🐾 PetParadise</span>
                    @if (!string.IsNullOrEmpty(currentRole) && currentRole != "Customer")
                    {
                        <span class="badge rounded-pill @(currentRole == "Owner" ? "bg-warning text-dark fw-bold" : "bg-dark fw-normal") fs-6">
                            @(currentRole == "Owner" ? "👑 Owner" : currentRole)
                        </span>
                    }
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto gap-1 flex-nowrap">
                        @if (currentRole == "Admin" || currentRole == "Owner")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Dashboard">แดชบอร์ด</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Orders">คำสั่งซื้อ</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Pets">ตรวจสัตว์เลี้ยง</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Warehouse">คลังสินค้า</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Delivery">จัดส่ง</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="AdminProduct" asp-action="Index">สินค้า</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Promotions">โปรโมชั่น</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Reports">รายงาน</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Users">ผู้ใช้งาน</a></li>
                        }
                        else if (currentRole == "Accounting")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Reports">รายงานการเงิน & ภาษี</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Orders">ตรวจสอบสลิป & การชำระเงิน</a></li>
                        }
                        else if (currentRole == "Marketing")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Promotions">จัดการแคมเปญโปรโมชั่น</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Reports">วิเคราะห์สินค้าขายดี & ยอดขาย</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Promotion" asp-action="Index">ดูหน้าโปรโมชั่นลูกค้า</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Product" asp-action="Index">ดูสินค้าหน้าร้าน</a></li>
                        }
                        else if (currentRole == "Staff")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Orders">ตรวจสอบออเดอร์</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Pets">ตรวจสอบรูปสัตว์เลี้ยง</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Warehouse">เตรียม/แพ็กสินค้า</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Product" asp-action="Index">ดูสินค้าหน้าร้าน</a></li>
                        }
                        else if (currentRole == "Warehouse")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Warehouse">คลังสินค้าและแพ็กพัสดุ</a></li>
                        }
                        else if (currentRole == "Delivery")
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Admin" asp-action="Delivery">รายการจัดส่งสินค้า</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Product" asp-action="Index">สินค้าทั้งหมด</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Promotion" asp-action="Index">โปรโมชั่น</a></li>
                            <li class="nav-item"><a class="nav-link nav-link-modern text-nowrap" asp-controller="Order" asp-action="Tracking">ติดตามคำสั่งซื้อ</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav gap-2 align-items-center mt-2 mt-lg-0 flex-nowrap">
                        @if (!string.IsNullOrEmpty(currentRole) && currentRole != "Customer")
                        {
                            <li class="nav-item text-nowrap">
                                <span class="text-muted small fw-medium me-1 text-nowrap">สวัสดี, @currentUsername</span>
                            </li>
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap" asp-controller="Account" asp-action="Logout">ออกจากระบบ</a>
                            </li>
                        }
                        else if (!string.IsNullOrEmpty(currentUsername))
                        {
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-pp-outline btn-sm rounded-pill px-3 text-nowrap" asp-controller="Account" asp-action="Profile">@currentUsername</a>
                            </li>
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-pp-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-controller="Cart" asp-action="Index">
                                    <span>🛒 ตะกร้า</span>
                                    <span class="badge rounded-pill @(cartItemCount > 0 ? "bg-warning text-dark" : "bg-light text-dark")">@cartItemCount</span>
                                </a>
                            </li>
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-link text-danger text-decoration-none btn-sm text-nowrap" asp-controller="Account" asp-action="Logout">ออก</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-pp-outline btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1 text-nowrap" asp-controller="Cart" asp-action="Index">
                                    <span>🛒 ตะกร้า</span>
                                    @if (cartItemCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger text-white">@cartItemCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item text-nowrap">
                                <a class="btn btn-pp-primary btn-sm rounded-pill px-4 text-nowrap" asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2569 <strong>PetParadise</strong> — ร้านจำหน่ายอาหารและอุปกรณ์สำหรับสัตว์เลี้ยงที่คุณรัก
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>