@model PetParadise.Models.Product

<div class="container mt-4">
    <h2>Edit Product</h2>
    <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" class="mt-3">
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">ชื่อสินค้า</label>
            <input asp-for="ProductName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">หมวดหมู่</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required></select>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="Price" class="form-label">ราคา (บาท)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Weight" class="form-label">น้ำหนัก (kg)</label>
                <input asp-for="Weight" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="StockQuantity" class="form-label">จำนวนสต็อก</label>
                <input asp-for="StockQuantity" type="number" class="form-control" required />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Status" class="form-label">สถานะ</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">รายละเอียดสินค้า</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">URL รูปภาพ</label>
            <input name="ImageUrl" value="@ViewBag.FirstImage" class="form-control" />
        </div>

        <button type="submit" class="btn btn-warning">บันทึกการแก้ไข</button>
        <a asp-action="Index" class="btn btn-secondary">ยกเลิก</a>
    </form>
</div>