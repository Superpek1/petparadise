@model PetParadise.Models.Order
@{
    var activeOrders = ViewBag.ActiveOrders as List<PetParadise.Models.Order> ?? new List<PetParadise.Models.Order>();
    var deliveryNotes = ViewBag.DeliveryNotes as Dictionary<int, PetParadise.Models.DeliveryTrackingNote>
                        ?? new Dictionary<int, PetParadise.Models.DeliveryTrackingNote>();
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;

    // รายการคำสั่งซื้อที่จะแสดง:
    // - หากมีการค้นหาหรือคลิกระบุ orderId (Model != null) ให้แสดงคำสั่งซื้อนั้นเป็นรายการแรก
    //   พร้อมแสดงคำสั่งซื้อที่กำลังดำเนินการอื่นๆ ของผู้ใช้ด้านล่าง
    // - หากไม่ได้ระบุ orderId ให้แสดงคำสั่งซื้อของตัวเองที่ยังไม่ได้จัดส่งสำเร็จทั้งหมดทันที
    var ordersToDisplay = new List<PetParadise.Models.Order>();
    if (Model != null)
    {
        ordersToDisplay.Add(Model);
    }
    foreach (var ao in activeOrders)
    {
        if (ordersToDisplay.All(o => o.OrderId != ao.OrderId))
        {
            ordersToDisplay.Add(ao);
        }
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">📦 ตรวจสอบและติดตามสถานะคำสั่งซื้อ</h3>
        @if (isLoggedIn)
        {
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary btn-sm">
                ดูประวัติคำสั่งซื้อทั้งหมดในโปรไฟล์ &rarr;
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- กล่องค้นหาด้วยเลขคำสั่งซื้อ -->
    <div class="card shadow-sm p-3 mb-4">
        <form asp-action="Tracking" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <input type="number" name="orderId" class="form-control" placeholder="ค้นหาด้วยหมายเลขคำสั่งซื้อ (Order ID)..." value="@(Model?.OrderId)" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">ค้นหาสถานะ</button>
                @if (Model != null)
                {
                    <a asp-action="Tracking" class="btn btn-outline-secondary">แสดงทั้งหมด</a>
                }
            </div>
        </form>
    </div>

    @if (isLoggedIn && Model == null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-primary mb-0">
                🚚 คำสั่งซื้อของคุณที่กำลังดำเนินการ (ยังไม่ได้จัดส่งสำเร็จ): @activeOrders.Count รายการ
            </h5>
        </div>
    }

    @if (ordersToDisplay.Any())
    {
        foreach (var ord in ordersToDisplay)
        {
            var payment = ord.Payments.FirstOrDefault();
            var deliveryNote = deliveryNotes.ContainsKey(ord.OrderId) ? deliveryNotes[ord.OrderId] : null;
            bool isSearchedOrder = (Model != null && Model.OrderId == ord.OrderId);

            <div class="card shadow-sm mb-4 @(isSearchedOrder ? "border-primary border-2" : "")">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-bold">คำสั่งซื้อเลขที่: #@ord.OrderId</span>
                        @if (ord.Status != "Completed" && ord.Status != "Cancelled")
                        {
                            <span class="badge bg-warning text-dark ms-2">กำลังดำเนินการ</span>
                        }
                    </div>
                    <span>วันที่สั่งซื้อ: @ord.OrderDate?.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="card-body">
                    <!-- แถบสถานะแบบ Progress Step ครบ 5 ขั้นตอน -->
                    <div class="mb-4">
                        <h6 class="fw-bold">
                            สถานะปัจจุบัน:
                            @if (ord.Status == "Cancelled")
                            {
                                <span class="badge bg-danger fs-6">Cancelled (ยกเลิกแล้ว)</span>
                            }
                            else
                            {
                                string statusTh = ord.Status switch
                                {
                                    "Pending" => "รอชำระเงิน (Pending)",
                                    "Paid" => "ชำระเงินแล้ว (Paid)",
                                    "Preparing" => "กำลังเตรียมสินค้า (Preparing)",
                                    "Shipped" => "กำลังจัดส่ง (Shipped)",
                                    "Completed" => "จัดส่งสำเร็จ (Completed)",
                                    _ => ord.Status
                                };
                                <span class="badge bg-info text-dark fs-6">@statusTh</span>
                            }
                        </h6>

                        @if (ord.Status != "Cancelled")
                        {
                            <div class="progress mt-2" style="height: 10px;">
                                @{
                                    int progress = 20;
                                    if (ord.Status == "Paid") progress = 40;
                                    else if (ord.Status == "Preparing") progress = 60;
                                    else if (ord.Status == "Shipped") progress = 80;
                                    else if (ord.Status == "Completed") progress = 100;
                                }
                                <div class="progress-bar bg-success" role="progressbar" style="width: @progress%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mt-2">
                                <span class="@(ord.Status == "Pending" ? "fw-bold text-dark" : "")">1. รอชำระเงิน</span>
                                <span class="@(ord.Status == "Paid" ? "fw-bold text-dark" : "")">2. ชำระเงินแล้ว</span>
                                <span class="@(ord.Status == "Preparing" ? "fw-bold text-dark" : "")">3. กำลังเตรียมสินค้า</span>
                                <span class="@(ord.Status == "Shipped" ? "fw-bold text-dark" : "")">4. กำลังจัดส่ง</span>
                                <span class="@(ord.Status == "Completed" ? "fw-bold text-success" : "")">5. จัดส่งสำเร็จ</span>
                            </div>
                        }
                    </div>

                    @if (deliveryNote != null && (!string.IsNullOrEmpty(deliveryNote.TrackingNumber) || !string.IsNullOrEmpty(deliveryNote.DeliveryIssue)))
                    {
                        <div class="alert alert-info mb-3">
                            @if (!string.IsNullOrEmpty(deliveryNote.TrackingNumber))
                            {
                                <div><strong>🚚 เลขพัสดุ / ข้อมูลการจัดส่ง:</strong> @deliveryNote.TrackingNumber @(string.IsNullOrEmpty(deliveryNote.CarrierName) ? "" : $"({deliveryNote.CarrierName})")</div>
                            }
                            @if (!string.IsNullOrEmpty(deliveryNote.DeliveryIssue))
                            {
                                <div class="text-danger mt-1"><strong>⚠️ แจ้งหมายเหตุการจัดส่ง:</strong> @deliveryNote.DeliveryIssue</div>
                            }
                        </div>
                    }

                    <!-- แจ้งชำระเงิน (กรณีรอชำระเงิน) -->
                    @if (ord.Status == "Pending")
                    {
                        <div class="card bg-light border mb-3">
                            <div class="card-body py-2 px-3">
                                <form asp-action="UploadPaymentSlip" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                                    <input type="hidden" name="orderId" value="@ord.OrderId" />
                                    <div class="col-md-4">
                                        <strong class="small">💳 แจ้งชำระเงิน / อัปโหลดสลิป:</strong>
                                        @if (payment != null && !string.IsNullOrEmpty(payment.PaymentSlip))
                                        {
                                            <span class="badge bg-success ms-1">แนบสลิปแล้ว</span>
                                        }
                                    </div>
                                    <div class="col-md-5">
                                        <input type="file" name="slipFile" class="form-control form-control-sm" accept="image/*" required />
                                    </div>
                                    <div class="col-md-3 d-grid">
                                        <button type="submit" class="btn btn-success btn-sm fw-bold">แจ้งชำระเงิน</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }

                    <hr />

                    <!-- รายการสินค้าในออเดอร์ -->
                    <h6 class="fw-bold mb-3">รายการสินค้า</h6>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in ord.Orderitems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <strong>@(item.Product?.ProductName ?? "สินค้าในคำสั่งซื้อ")</strong>
                                    <small class="text-muted d-block">จำนวน: @item.Quantity ชิ้น x @item.UnitPrice.ToString("N2") ฿</small>
                                </div>
                                <span class="fw-bold">@((item.Quantity * item.UnitPrice).ToString("N2")) ฿</span>
                            </li>
                        }
                    </ul>

                    <!-- ยอดเงินรวม -->
                    <div class="text-end">
                        <p class="mb-1 text-muted">ยอดรวมสินค้า: @ord.Subtotal.ToString("N2") ฿</p>
                        @if (ord.Discount != null && ord.Discount > 0)
                        {
                            <p class="mb-1 text-success">ส่วนลดโปรโมชั่น @(ord.Promotion != null ? $"({ord.Promotion.PromotionName})" : ""): -@ord.Discount?.ToString("N2") ฿</p>
                        }
                        <p class="mb-1 text-muted">
                            ค่าจัดส่ง:
                            @if ((ord.ShippingFee ?? 0) == 0 && ord.Promotion?.PromotionType == "FreeShipping")
                            {
                                <span class="text-success fw-bold">0.00 ฿ (โปรโมชั่นส่งฟรี)</span>
                            }
                            else
                            {
                                <span>@((ord.ShippingFee ?? 0).ToString("N2")) ฿</span>
                            }
                        </p>
                        <p class="mb-1 text-muted">ภาษีมูลค่าเพิ่ม (VAT 7%): @((ord.Vat ?? 0).ToString("N2")) ฿</p>
                        <h4 class="fw-bold text-danger">ยอดรวมทั้งสิ้น: @ord.TotalAmount.ToString("N2") บาท</h4>
                    </div>

                    <!-- ปุ่มพิมพ์ใบเสร็จ และ ปุ่มยกเลิกคำสั่งซื้อ -->
                    <hr />
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <a asp-controller="Order" asp-action="Receipt" asp-route-orderId="@ord.OrderId" target="_blank" class="btn btn-outline-dark btn-sm fw-bold">
                            🖨️ พิมพ์ใบเสร็จ / ใบสรุปคำสั่งซื้อ
                        </a>
                        @if (ord.Status == "Pending" || ord.Status == "Paid" || ord.Status == "Preparing")
                        {
                            <form asp-controller="Order" asp-action="CancelOrder" method="post" onsubmit="return confirm('คุณแน่ใจหรือไม่ว่าต้องการยกเลิกคำสั่งซื้อเลขที่ #@ord.OrderId ?');">
                                <input type="hidden" name="orderId" value="@ord.OrderId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                                    ยกเลิกคำสั่งซื้อ
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (isLoggedIn)
    {
        <div class="card shadow-sm p-5 text-center">
            <div class="fs-1 mb-2">🎉</div>
            <h5 class="fw-bold text-dark">คุณไม่มีคำสั่งซื้อที่ค้างจัดส่งในขณะนี้</h5>
            <p class="text-muted small mb-3">คำสั่งซื้อทั้งหมดของคุณถูกจัดส่งสำเร็จแล้ว หรือยังไม่มีคำสั่งซื้อใหม่ที่อยู่ระหว่างดำเนินการ</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">เลือกซื้อสินค้าเพิ่ม</a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">ดูประวัติคำสั่งซื้อที่สำเร็จแล้ว</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm p-4 text-center">
            <p class="text-muted mb-2">กรุณาเข้าสู่ระบบเพื่อดูคำสั่งซื้อที่กำลังดำเนินการของคุณโดยอัตโนมัติ หรือกรอกเลขคำสั่งซื้อในช่องค้นหาด้านบน</p>
            <div>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-4">เข้าสู่ระบบ</a>
            </div>
        </div>
    }
</div>
