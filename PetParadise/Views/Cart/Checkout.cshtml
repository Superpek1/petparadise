@model IEnumerable<PetParadise.Models.Cartitem>
@{
    var addresses = ViewBag.Addresses as List<PetParadise.Models.Address> ?? new List<PetParadise.Models.Address>();
    var promotions = ViewBag.Promotions as List<PetParadise.Models.Promotion> ?? new List<PetParadise.Models.Promotion>();
    var promoEvals = ViewBag.PromoEvaluations as Dictionary<int, PetParadise.Models.PromotionEvaluationResult>
                     ?? new Dictionary<int, PetParadise.Models.PromotionEvaluationResult>();
    var systemNotes = PetParadise.Models.PromotionHelper.LoadSystemNotes();

    decimal subtotal = Model.Sum(i => i.Quantity * i.Product.Price);
    decimal totalWeight = Model.Sum(i => i.Quantity * i.Product.Weight);
    decimal shippingFee = PetParadise.Models.PromotionHelper.CalculateShippingFee(totalWeight);
    decimal vat = Math.Round((subtotal + shippingFee) * 0.07m, 2);
    decimal grandTotal = subtotal + shippingFee + vat;
}

<div class="container mt-4">
    <h3 class="fw-bold mb-4">ยืนยันคำสั่งซื้อและการชำระเงิน</h3>

    <form asp-action="ConfirmOrder" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <!-- ฝั่งซ้าย: ข้อมูลผู้รับและที่อยู่ -->
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0 text-white">ข้อมูลผู้รับและสถานที่จัดส่ง</h5>
                    </div>
                    <div class="card-body">
                        @if (addresses.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">เลือกจากที่อยู่ที่บันทึกไว้:</label>
                                <select name="selectedAddressId" id="addressSelect" class="form-select" onchange="toggleNewAddress(this.value)">
                                    @foreach (var addr in addresses)
                                    {
                                        <option value="@addr.AddressId">
                                            @addr.RecipientName (@addr.Phone) - @addr.AddressDetail @addr.District @addr.Province @addr.PostalCode
                                        </option>
                                    }
                                    <option value="0">+ กรอกที่อยู่จัดส่งใหม่...</option>
                                </select>
                            </div>
                        }

                        <div id="newAddressForm" style="display: @(addresses.Any() ? "none" : "block");">
                            <div class="mb-3">
                                <label class="form-label fw-bold">ชื่อ-นามสกุล ผู้รับ</label>
                                <input type="text" name="recipientName" class="form-control" placeholder="ชื่อ นามสกุล" @(addresses.Any() ? "" : "required") />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">เบอร์โทรศัพท์</label>
                                <input type="text" name="phone" class="form-control" placeholder="08x-xxx-xxxx" @(addresses.Any() ? "" : "required") />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">ที่อยู่สำหรับจัดส่ง</label>
                                <textarea name="addressDetail" class="form-control" rows="3" placeholder="บ้านเลขที่ ซอย ถนน ตำบล อำเภอ จังหวัด รหัสไปรษณีย์" @(addresses.Any() ? "" : "required")></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- วิธีการชำระเงิน -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0 text-white">วิธีการชำระเงิน</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">เลือกช่องทางการชำระเงิน:</label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payBank" value="Bank Transfer" checked />
                                <label class="form-check-label fw-bold" for="payBank">โอนเงินผ่านบัญชีธนาคาร (แนบสลิป)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payPromptPay" value="PromptPay QR" />
                                <label class="form-check-label fw-bold" for="payPromptPay">สแกนจ่าย PromptPay QR Code</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payCOD" value="Cash on Delivery (COD)" />
                                <label class="form-check-label fw-bold" for="payCOD">ชำระเงินปลายทาง (COD)</label>
                            </div>
                        </div>
                        <div class="bg-light p-3 rounded mb-3 small">
                            <div>ธนาคารกสิกรไทย: <strong>123-4-56789-0</strong> | พร้อมเพย์: <strong>080-000-0000</strong></div>
                            <div>ชื่อบัญชี: บจก. เพ็ท พาราไดซ์</div>
                        </div>
                        <label class="form-label fw-bold">แนบหลักฐานการโอน (สลิป):</label>
                        <input type="file" name="slipFile" class="form-control" accept="image/*" />
                        <small class="text-muted">สามารถแนบสลิปตอนนี้ หรือแจ้งชำระเงินภายหลังในหน้าติดตามคำสั่งซื้อได้</small>
                    </div>
                </div>
            </div>

            <!-- ฝั่งขวา: โปรโมชั่นและสรุปยอดคำสั่งซื้อ -->
            <div class="col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0 text-white">สรุปยอดคำสั่งซื้อ</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.Product.ProductName (x@(item.Quantity))</span>
                                <span>@((item.Quantity * item.Product.Price).ToString("N2")) ฿</span>
                            </div>
                        }
                        <hr />

                        <!-- ช่องกรอกโค้ดส่วนลด + กล่องเลือกโปรโมชั่น -->
                        <div class="p-3 bg-light rounded border mb-3">
                            <label class="form-label fw-bold text-success mb-1">🎟️ กรอกโค้ดส่วนลด / โปรโมชั่น:</label>
                            <div class="input-group input-group-sm mb-2">
                                <input type="text"
                                       name="promoCode"
                                       id="promoCodeInput"
                                       class="form-control text-uppercase fw-bold"
                                       placeholder="กรอกโค้ด เช่น NEW10, SAVE150, FREESHIP..."
                                       onkeydown="if(event.key==='Enter'){event.preventDefault();applyPromoCode();}" />
                                <button type="button" class="btn btn-success fw-bold px-3" onclick="applyPromoCode()">ใช้โค้ด</button>
                                <button type="button" class="btn btn-outline-secondary" onclick="clearPromoCode()">ล้าง</button>
                            </div>

                            <!-- ปุ่มกดเลือกโค้ดด่วน -->
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var p in promotions)
                                {
                                    string code = PetParadise.Models.PromotionHelper.GetPromoCode(p, systemNotes);
                                    var eval = promoEvals.ContainsKey(p.PromotionId)
                                        ? promoEvals[p.PromotionId]
                                        : new PetParadise.Models.PromotionEvaluationResult();
                                    <button type="button"
                                            class="badge border-0 @(eval.IsEligible ? "bg-warning text-dark" : "bg-secondary opacity-50")"
                                            style="cursor: pointer;"
                                            title="@(eval.IsEligible ? p.PromotionName : eval.IneligibleReason)"
                                            onclick="document.getElementById('promoCodeInput').value='@code'; applyPromoCode();">
                                        @code
                                    </button>
                                }
                            </div>

                            <div id="promoCodeFeedback" class="small fw-semibold mb-2" style="display:none;"></div>

                            <label class="form-label small fw-bold text-muted mb-1">หรือเลือกจากรายการโปรโมชั่น:</label>
                            <select name="selectedPromotionId" id="promoSelect" class="form-select form-select-sm" onchange="onDropdownChange()">
                                <option value="0" data-code="" data-discount="0" data-freeship="false" data-eligible="true" data-condition="">-- ไม่ใช้โปรโมชั่น --</option>
                                @foreach (var p in promotions)
                                {
                                    string code = PetParadise.Models.PromotionHelper.GetPromoCode(p, systemNotes);
                                    var eval = promoEvals.ContainsKey(p.PromotionId)
                                        ? promoEvals[p.PromotionId]
                                        : new PetParadise.Models.PromotionEvaluationResult();

                                    string benefitLabel = eval.IsFreeShipping
                                        ? "ส่งฟรี"
                                        : $"ลด {eval.DiscountAmount:N2}฿";

                                    <option value="@p.PromotionId"
                                            disabled="@(!eval.IsEligible)"
                                            data-code="@code"
                                            data-altcode="PROMO@(p.PromotionId)"
                                            data-name="@p.PromotionName"
                                            data-eligible="@(eval.IsEligible ? "true" : "false")"
                                            data-reason="@eval.IneligibleReason"
                                            data-discount="@eval.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-freeship="@(eval.IsFreeShipping ? "true" : "false")"
                                            data-condition="@eval.ConditionText">
                                        [@code] @p.PromotionName @(eval.IsEligible ? $"({benefitLabel})" : $"[ไม่เข้าเงื่อนไข: {eval.IneligibleReason}]")
                                    </option>
                                }
                            </select>
                            <small id="promoConditionHint" class="text-muted d-block mt-1"></small>
                        </div>

                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>ราคาสินค้ารวม:</span>
                            <span>@subtotal.ToString("N2") ฿</span>
                        </div>
                        <div class="d-flex justify-content-between text-success mb-1" id="discountRow" style="display:none !important;">
                            <span>ส่วนลดโปรโมชั่น:</span>
                            <span id="discountText">-0.00 ฿</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>ค่าจัดส่ง (น้ำหนักรวม @totalWeight.ToString("N2") kg):</span>
                            <span id="shippingText">@shippingFee.ToString("N2") ฿</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted mb-3">
                            <span>ภาษีมูลค่าเพิ่ม (VAT 7%):</span>
                            <span id="vatText">@vat.ToString("N2") ฿</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">ยอดสุทธิทั้งหมด:</h5>
                            <h4 class="fw-bold text-danger mb-0" id="grandTotalText">@grandTotal.ToString("N2") ฿</h4>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">ยืนยันการสั่งซื้อ</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">กลับไปแก้ไขตะกร้า</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    const baseSubtotal = @subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const baseShipping = @shippingFee.ToString(System.Globalization.CultureInfo.InvariantCulture);

    function toggleNewAddress(val) {
        var form = document.getElementById("newAddressForm");
        form.style.display = (val == "0") ? "block" : "none";
    }

    function showFeedback(message, isSuccess) {
        var fb = document.getElementById("promoCodeFeedback");
        if (!message) {
            fb.style.display = "none";
            fb.innerText = "";
            return;
        }
        fb.style.display = "block";
        fb.className = "small fw-semibold mb-2 " + (isSuccess ? "text-success" : "text-danger");
        fb.innerText = message;
    }

    function applyPromoCode() {
        var input = document.getElementById("promoCodeInput");
        var rawCode = (input.value || "").trim().replace(/^#/, "").toUpperCase();
        var select = document.getElementById("promoSelect");

        if (!rawCode) {
            select.value = "0";
            showFeedback("กรุณากรอกโค้ดส่วนลด", false);
            recalculateTotal();
            return;
        }

        var matchedOpt = null;
        for (var i = 1; i < select.options.length; i++) {
            var opt = select.options[i];
            var code = (opt.getAttribute("data-code") || "").toUpperCase();
            var altCode = (opt.getAttribute("data-altcode") || "").toUpperCase();
            var promoId = opt.value;

            if (rawCode === code || rawCode === altCode || rawCode === promoId) {
                matchedOpt = opt;
                break;
            }
        }

        if (!matchedOpt) {
            select.value = "0";
            showFeedback("❌ ไม่พบโค้ดโปรโมชั่น '" + rawCode + "' ในระบบ", false);
            recalculateTotal();
            return;
        }

        var isEligible = matchedOpt.getAttribute("data-eligible") === "true";
        var promoName = matchedOpt.getAttribute("data-name") || rawCode;
        var reason = matchedOpt.getAttribute("data-reason") || "ไม่ตรงตามเงื่อนไข";

        if (!isEligible) {
            select.value = "0";
            showFeedback("⚠️ โค้ด '" + rawCode + "' (" + promoName + ") ไม่สามารถใช้ได้: " + reason, false);
            recalculateTotal();
            return;
        }

        select.value = matchedOpt.value;
        input.value = matchedOpt.getAttribute("data-code");
        showFeedback("✅ ใช้โค้ด '" + input.value + "' (" + promoName + ") สำเร็จ!", true);
        recalculateTotal();
    }

    function clearPromoCode() {
        document.getElementById("promoCodeInput").value = "";
        document.getElementById("promoSelect").value = "0";
        showFeedback("", true);
        recalculateTotal();
    }

    function onDropdownChange() {
        var select = document.getElementById("promoSelect");
        var opt = select.options[select.selectedIndex];
        var code = opt.getAttribute("data-code") || "";
        var name = opt.getAttribute("data-name") || "";
        document.getElementById("promoCodeInput").value = code;

        if (code) {
            showFeedback("✅ เลือกใช้โค้ด '" + code + "' (" + name + ") สำเร็จ!", true);
        } else {
            showFeedback("", true);
        }
        recalculateTotal();
    }

    function recalculateTotal() {
        var select = document.getElementById("promoSelect");
        var opt = select.options[select.selectedIndex];

        var discount = parseFloat(opt.getAttribute("data-discount")) || 0;
        var isFreeShip = opt.getAttribute("data-freeship") === "true";
        var conditionText = opt.getAttribute("data-condition") || "";

        document.getElementById("promoConditionHint").innerText = conditionText;

        if (discount > baseSubtotal) discount = baseSubtotal;

        var discountRow = document.getElementById("discountRow");
        if (discount > 0) {
            discountRow.style.setProperty("display", "flex", "important");
            document.getElementById("discountText").innerText = "-" + discount.toFixed(2) + " ฿";
        } else {
            discountRow.style.setProperty("display", "none", "important");
        }

        var afterDiscount = Math.max(0, baseSubtotal - discount);
        var currentShipping = (isFreeShip && afterDiscount >= 799) ? 0 : baseShipping;

        if (currentShipping === 0 && baseShipping > 0) {
            document.getElementById("shippingText").innerHTML = '<span class="text-success fw-bold">0.00 ฿ (ส่งฟรี!)</span>';
        } else {
            document.getElementById("shippingText").innerText = currentShipping.toFixed(2) + " ฿";
        }

        var vat = Math.round(((afterDiscount + currentShipping) * 0.07) * 100) / 100;
        var grandTotal = afterDiscount + currentShipping + vat;

        document.getElementById("vatText").innerText = vat.toFixed(2) + " ฿";
        document.getElementById("grandTotalText").innerText = grandTotal.toFixed(2) + " ฿";
    }
</script>
