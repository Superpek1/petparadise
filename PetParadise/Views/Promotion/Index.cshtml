@model IEnumerable<PetParadise.Models.Promotion>
@{
    var systemNotes = PetParadise.Models.PromotionHelper.LoadSystemNotes();
}

<div class="container mt-4 p-4 bg-white text-dark rounded shadow-sm">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark">🎁 โปรโมชั่นและโค้ดส่วนลดพิเศษ</h2>
        <p class="text-secondary">คัดลอกโค้ดส่วนลดด้านล่างเพื่อนำไปกรอกหรือเลือกใช้ในหน้าชำระเงินได้ทันที</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var promo in Model)
            {
                string code = PetParadise.Models.PromotionHelper.GetPromoCode(promo, systemNotes);
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-warning shadow-sm">
                        <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
                            <span>โค้ด: <strong class="text-danger">@code</strong></span>
                            <span class="badge bg-danger">
                                @if (promo.PromotionType == "FreeShipping")
                                {
                                    <span>จัดส่งฟรี</span>
                                }
                                else if (promo.DiscountPercent != null && promo.DiscountPercent > 0)
                                {
                                    <span>ลด @promo.DiscountPercent?.ToString("N0")%</span>
                                }
                                else if (promo.DiscountAmount != null && promo.DiscountAmount > 0)
                                {
                                    <span>ลด @promo.DiscountAmount?.ToString("N2") ฿</span>
                                }
                            </span>
                        </div>
                        <div class="card-body bg-light text-dark">
                            <h5 class="card-title fw-bold text-dark">@promo.PromotionName</h5>
                            <span class="badge bg-secondary mb-2">ประเภท: @promo.PromotionType</span>
                            <ul class="list-unstyled small text-muted mt-2 mb-0">
                                @if (promo.PromotionType == "FirstOrder")
                                {
                                    <li>• สำหรับสมาชิกที่สั่งซื้อสินค้าเป็นครั้งแรก</li>
                                    <li>• ยอดสั่งซื้อขั้นต่ำ @((promo.MinPurchase ?? 500).ToString("N0")) บาท</li>
                                    <li>• ลดสูงสุดไม่เกิน @((promo.MaxDiscount ?? 100).ToString("N0")) บาท</li>
                                }
                                else if (promo.PromotionType == "Fixed")
                                {
                                    <li>• ยอดสั่งซื้อขั้นต่ำ @((promo.MinPurchase ?? 1000).ToString("N0")) บาท</li>
                                    <li>• ใช้ได้กับสินค้าทุกประเภท</li>
                                    <li>• จำกัดการใช้ 1 ครั้งต่อคำสั่งซื้อ</li>
                                }
                                else if (promo.PromotionType == "BulkItem")
                                {
                                    <li>• ต้องเป็นสินค้าชนิดเดียวกัน ซื้อขั้นต่ำ 3 ชิ้นขึ้นไป</li>
                                    <li>• ส่วนลด @((promo.DiscountPercent ?? 15).ToString("N0"))% คิดเฉพาะสินค้ารายการนั้น</li>
                                }
                                else if (promo.PromotionType == "FreeShipping")
                                {
                                    <li>• ยอดสั่งซื้อหลังหักส่วนลดไม่น้อยกว่า @((promo.MinPurchase ?? 799).ToString("N0")) บาท</li>
                                    <li>• ใช้ได้เฉพาะการจัดส่งภายในประเทศ</li>
                                }
                                else if (promo.PromotionType == "BirthdayPet")
                                {
                                    <li>• ลูกค้าต้องลงทะเบียนข้อมูลสัตว์เลี้ยงในระบบ (หน้าโปรไฟล์)</li>
                                    <li>• ใช้ได้เฉพาะเดือนเกิดของสัตว์เลี้ยง</li>
                                    <li>• ลดสูงสุด @((promo.MaxDiscount ?? 200).ToString("N0")) บาท</li>
                                }
                                else
                                {
                                    <li>• ยอดซื้อขั้นต่ำ: @(promo.MinPurchase?.ToString("N2") ?? "0.00") บาท</li>
                                    @if (promo.MaxDiscount != null)
                                    {
                                        <li>• ลดสูงสุด: @promo.MaxDiscount?.ToString("N2") บาท</li>
                                    }
                                }
                                <li class="mt-1"><strong>ระยะเวลา:</strong> @promo.StartDate.ToString("dd/MM/yyyy") - @promo.EndDate.ToString("dd/MM/yyyy")</li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 d-flex gap-2">
                            <button type="button" class="btn btn-warning fw-bold flex-grow-1" onclick="copyCode('@code', this)">
                                📋 คัดลอกโค้ด @code
                            </button>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark">
                                ซื้อสินค้า
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <h4>ยังไม่มีโปรโมชั่นที่เปิดใช้งานในขณะนี้</h4>
            </div>
        }
    </div>
</div>

<script>
    function copyCode(code, btn) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(code);
        }
        var oldText = btn.innerText;
        btn.innerText = "✅ คัดลอก " + code + " แล้ว!";
        setTimeout(function () { btn.innerText = oldText; }, 2000);
    }
</script>
